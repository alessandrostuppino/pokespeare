{
  "sourceLanguage" : "en",
  "strings" : {
    "Are you sure you want to delete all the search history?\n\nThis will require the use of an internet connection even for the Pokémon already displayed." : {
      "comment" : "Body of the confirmation alert shown before clearing the search history.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi davvero cancellare tutta la cronologia delle ricerche?\n\nServirà una connessione a internet anche per i Pokémon già visualizzati."
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Button that dismisses the history deletion alert without deleting.",
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla"
          }
        }
